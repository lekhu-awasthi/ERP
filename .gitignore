# .NET
bin/
obj/
*.user
*.suo
.vs/
TestResults/
artifacts/

# Local file storage (Phase 18's IFileStorage local-disk dev implementation) — uploaded files land
# here at runtime, never something to commit.
src/Api/App_Data/

# Angular / Node
web/node_modules/
web/dist/
web/.angular/
npm-debug.log*

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Secrets — never commit real connection strings/keys.
# (Local dev secrets live outside the repo via `dotnet user-secrets`, not here —
# these patterns are just a backstop in case one ever gets created by mistake.)
*.env
appsettings.*.local.json
secrets.json
testsprite_tests/tmp/
testsprite_tests/tmp/config.json

# Phase 25: the ASP.NET dev certificate, exported so `ng serve --ssl` can present one the
# browser already trusts (see docs/phase-25-status.md's browser-pass note). Regenerate with:
#   dotnet dev-certs https --export-path .certs/dev.pem --format PEM --no-password
.certs/

# Phase 34c: the scale harness's local run state. The scripts and the measured results are
# committed (tools/scale/*.sh, *.sql, results-*.csv); the cookie jars and the per-run organization
# ids that only make sense on the machine that seeded them are not.
tools/scale/.cookies*
tools/scale/.seed-ids.env
